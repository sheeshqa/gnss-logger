{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gnss-logger:stage2:range:2",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "gnss_logger.stage2.range"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "contract_version": {
      "const": "stage2.3/v2"
    },
    "run_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "connection_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "journal_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "enum": [
        "FRAME",
        "OPAQUE",
        "TAIL"
      ]
    },
    "artifact_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid-hex"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "contract_version",
    "run_id",
    "attempt_id",
    "connection_id",
    "journal_id",
    "start",
    "end",
    "kind",
    "artifact_id",
    "destination_offset"
  ],
  "additionalProperties": false
}
