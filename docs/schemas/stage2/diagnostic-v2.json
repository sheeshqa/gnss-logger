{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gnss-logger:stage2:diagnostic:2",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "gnss_logger.stage2.diagnostic"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "contract_version": {
      "const": "stage2.3/v2"
    },
    "run_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "utc": {
      "type": "string",
      "format": "utc"
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "STARTING",
        "IDENTIFYING",
        "RECORDING",
        "DISCONNECTED",
        "WAITING",
        "STORAGE_ERROR",
        "STOPPING",
        "STOPPED"
      ]
    },
    "registration": {
      "enum": [
        "STARTING",
        "ACTIVE",
        "WAITING",
        "STOPPED_COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "phase_quality": {
      "enum": [
        "NOT_EVALUATED",
        "NO_DATA",
        "WARNINGS",
        "NO_INDICATORS_DETECTED"
      ]
    },
    "hardware_validation": {
      "enum": [
        "NOT TESTED"
      ]
    },
    "accounting": {
      "type": "object",
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0
        },
        "journal_written": {
          "type": "integer",
          "minimum": 0
        },
        "journal_synced": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "unarchived": {
          "type": "integer",
          "minimum": 0
        },
        "framed": {
          "type": "integer",
          "minimum": 0
        },
        "opaque": {
          "type": "integer",
          "minimum": 0
        },
        "unclassified": {
          "type": "integer",
          "minimum": 0
        },
        "received_count_exact": {
          "type": "boolean"
        }
      },
      "required": [
        "received",
        "journal_written",
        "journal_synced",
        "pending",
        "unarchived",
        "framed",
        "opaque",
        "unclassified",
        "received_count_exact"
      ],
      "additionalProperties": false
    },
    "last_data_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_rawx_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_sfrbx_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_sync_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "utc"
        },
        {
          "type": "null"
        }
      ]
    },
    "free_disk_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "queue_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "reconnect_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "gap_events": {
      "type": "integer",
      "minimum": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "projection": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "projected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "opaque_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tail_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "pending_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "backlog_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_frontier": {
          "type": "integer",
          "minimum": 0
        },
        "receipt_index": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "range_index": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "bytes",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_directory": {
          "type": "string",
          "minLength": 1
        },
        "closed_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "verified_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "verification_pending": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "boolean"
        },
        "finished": {
          "type": "boolean"
        },
        "time_state": {
          "enum": [
            "UNDATED",
            "CANDIDATE",
            "VALID",
            "DISCONTINUITY"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "time_policy": {
          "type": "object",
          "properties": {
            "period_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ttl_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "tolerance_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "anchors": {
              "const": 2
            }
          },
          "required": [
            "period_s",
            "ttl_s",
            "tolerance_s",
            "anchors"
          ],
          "additionalProperties": false
        },
        "time_checkpoint": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        },
        "active": {
          "anyOf": [
            {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "root",
        "cursor",
        "eligible_bytes",
        "projected_bytes",
        "opaque_bytes",
        "tail_bytes",
        "pending_bytes",
        "backlog_bytes",
        "receipt_frontier",
        "receipt_index",
        "range_index",
        "artifact_directory",
        "closed_artifacts",
        "verified_artifacts",
        "verification_pending",
        "failed",
        "finished",
        "time_state",
        "generation",
        "time_policy",
        "time_checkpoint",
        "active"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "contract_version",
    "run_id",
    "attempt_id",
    "utc",
    "monotonic_ns",
    "state",
    "registration",
    "phase_quality",
    "hardware_validation",
    "accounting",
    "last_data_utc",
    "last_rawx_utc",
    "last_sfrbx_utc",
    "last_sync_utc",
    "free_disk_bytes",
    "queue_bytes",
    "reconnect_attempts",
    "gap_events",
    "errors",
    "extensions",
    "projection"
  ],
  "additionalProperties": false
}
