{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gnss-logger:stage2:receipt:2",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "gnss_logger.stage2.receipt"
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "contract_version": {
      "const": "stage2.3/v2"
    },
    "run_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "connection_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "journal_id": {
      "type": "string",
      "format": "uuid-hex"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 0
    },
    "received_utc": {
      "type": "string",
      "format": "utc"
    },
    "monotonic_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "contract_version",
    "run_id",
    "attempt_id",
    "connection_id",
    "journal_id",
    "sequence",
    "start",
    "end",
    "received_utc",
    "monotonic_ns"
  ],
  "additionalProperties": false
}
